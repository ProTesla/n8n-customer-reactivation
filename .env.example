# Copy to .env (git-ignored) or set these before starting n8n, then restart n8n.
# Never commit the real values.

GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos
WEBHOOK_URL=https://YOUR-NGROK-DOMAIN

# Needed by WF3 (signature check) and WF1 (random unsubscribe tokens)
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Must match the secret you type into the Cal.com webhook form
CAL_WEBHOOK_SECRET=choose-a-long-random-secret

# Back this up somewhere safe. Without it, restored n8n backups cannot decrypt credentials.
# N8N_ENCRYPTION_KEY=
